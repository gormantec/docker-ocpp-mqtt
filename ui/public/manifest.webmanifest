{
  "name": "OCPP MQTT Bridge",
  "short_name": "OCPP Bridge",
  "description": "Monitor and control OCPP charging from your phone or desktop.",
  "id": "/webapp/ocpp-mqtt/",
  "start_url": "/webapp/ocpp-mqtt/",
  "scope": "/webapp/ocpp-mqtt/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#F0F2F3",
  "theme_color": "#232F3E",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "/webapp/ocpp-mqtt/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/webapp/ocpp-mqtt/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/webapp/ocpp-mqtt/icons/maskable-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}
